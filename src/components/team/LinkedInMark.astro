---
interface Props {
  href: string;
  name: string;
}

const { href, name } = Astro.props;
---

<a
  class="linkedin-mark"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${name} on LinkedIn`}
>
  <svg class="linkedin-mark__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.37V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0z"
    ></path>
  </svg>
</a>

<style>
  .linkedin-mark {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 44px;
    min-height: 44px;
    border-radius: 0.45rem;
    border: 1px solid rgba(232, 234, 237, 0.22);
    background: linear-gradient(
      155deg,
      rgba(232, 234, 237, 0.12) 0%,
      rgba(200, 204, 210, 0.06) 100%
    );
    color: var(--mercury);
    box-shadow:
      inset 0 1px 0 rgba(232, 234, 237, 0.18),
      0 8px 18px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .linkedin-mark::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      105deg,
      transparent 25%,
      rgba(232, 234, 237, 0.28) 50%,
      transparent 75%
    );
    background-size: 220% 100%;
    background-position: 130% 0;
    opacity: 0;
  }

  .linkedin-mark:hover {
    color: var(--mercury-bright);
    border-color: rgba(232, 234, 237, 0.4);
    background: linear-gradient(
      155deg,
      rgba(232, 234, 237, 0.18) 0%,
      rgba(200, 204, 210, 0.1) 100%
    );
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(232, 234, 237, 0.28),
      0 12px 24px rgba(0, 0, 0, 0.3);
  }

  .linkedin-mark:hover::before {
    opacity: 1;
    animation: linkedin-sweep 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .linkedin-mark__icon {
    position: relative;
    z-index: 1;
    width: 1.35rem;
    height: 1.35rem;
  }

  @keyframes linkedin-sweep {
    from {
      background-position: 130% 0;
    }
    to {
      background-position: -30% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .linkedin-mark,
    .linkedin-mark::before {
      transition: none;
      animation: none;
    }

    .linkedin-mark:hover {
      transform: none;
    }

    .linkedin-mark:hover::before {
      opacity: 0;
    }
  }
</style>
