---
interface Props {
  href: string;
  name: string;
}

const { href, name } = Astro.props;
---

<a
  class="linkedin-mark"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${name} on LinkedIn`}
>
  <svg class="linkedin-mark__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.37V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0z"
    ></path>
  </svg>
</a>

<style>
  .linkedin-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 44px;
    min-height: 44px;
    border-radius: 0.4rem;
    border: 1px solid var(--glass-border);
    background: rgba(200, 204, 210, 0.06);
    color: var(--mercury);
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .linkedin-mark:hover {
    color: var(--mercury-bright);
    border-color: rgba(232, 234, 237, 0.32);
    background: rgba(200, 204, 210, 0.12);
  }

  .linkedin-mark__icon {
    width: 1.35rem;
    height: 1.35rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .linkedin-mark {
      transition: none;
    }
  }
</style>
