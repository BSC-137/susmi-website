---
import type { Exec } from "../../types";

interface Props {
  execs: Exec[];
  activeId: string;
}

const { execs, activeId } = Astro.props;
---

<nav class="team-roster" aria-label="Executive roster" data-team-roster>
  <p class="team-roster__label">Roster</p>
  <ul class="team-roster__list" role="listbox" aria-label="Select an executive" data-roster-list>
    {
      execs.map((exec) => (
        <li role="none">
          <button
            type="button"
            class:list={["roster-item", exec.id === activeId && "is-active"]}
            role="option"
            id={`roster-${exec.id}`}
            data-roster-item={exec.id}
            aria-selected={exec.id === activeId ? "true" : "false"}
            tabindex={exec.id === activeId ? 0 : -1}
          >
            <span class="roster-item__dot" aria-hidden="true" />
            <span class="roster-item__text">
              <span class="roster-item__name">{exec.name}</span>
              <span class="roster-item__role">{exec.role}</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .team-roster__label {
    margin: 0 0 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mercury-dim);
  }

  .team-roster__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.25rem;
    -webkit-overflow-scrolling: touch;
  }

  .roster-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    width: max-content;
    min-width: 11.5rem;
    scroll-snap-align: start;
    text-align: left;
    margin: 0;
    padding: 0.75rem 0.85rem;
    border-radius: 0.45rem;
    border: 1px solid transparent;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .roster-item__dot {
    width: 0.4rem;
    height: 0.4rem;
    margin-top: 0.4rem;
    border-radius: 999px;
    background: var(--mercury-dim);
    flex-shrink: 0;
  }

  .roster-item__text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .roster-item__name {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--mercury-bright);
  }

  .roster-item__role {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  .roster-item.is-active,
  .roster-item[aria-selected="true"] {
    background: rgba(200, 204, 210, 0.07);
    border-color: rgba(232, 234, 237, 0.22);
    box-shadow: inset 2px 0 0 0 var(--mercury);
  }

  .roster-item.is-active .roster-item__dot,
  .roster-item[aria-selected="true"] .roster-item__dot {
    background: linear-gradient(180deg, #e8eaed, #8a9099);
    box-shadow: 0 0 10px rgba(232, 234, 237, 0.35);
  }

  .roster-item.is-active .roster-item__name {
    background-image: linear-gradient(90deg, transparent, var(--mercury-bright) 20%, transparent);
    background-size: 100% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
  }

  @media (min-width: 960px) {
    .team-roster {
      position: sticky;
      top: 5.5rem;
    }

    .team-roster__list {
      flex-direction: column;
      overflow: visible;
      scroll-snap-type: none;
      gap: 0.35rem;
    }

    .roster-item {
      width: 100%;
      min-width: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .roster-item {
      transition: none;
    }
  }
</style>
