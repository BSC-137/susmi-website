---
interface Props {
  intensity?: "hero" | "subtle";
  class?: string;
}

const { intensity = "hero", class: className = "" } = Astro.props;
---

<div
  class:list={["mercury-field", `mercury-field--${intensity}`, className]}
  data-mercury-root
  data-intensity={intensity}
  aria-hidden="true"
>
  <canvas class="mercury-field__canvas" data-mercury-canvas></canvas>
  <div class="mercury-field__veil"></div>
  <div class="mercury-field__fallback"></div>
</div>

<script>
  import { destroyAllMercuryFields, scheduleMercuryFields } from "../scripts/mercury";

  const boot = () => scheduleMercuryFields();

  boot();
  document.addEventListener("astro:page-load", boot);
  document.addEventListener("astro:before-swap", () => destroyAllMercuryFields());
</script>

<style>
  .mercury-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    isolation: isolate;
  }

  .mercury-field__canvas,
  .mercury-field__fallback,
  .mercury-field__veil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Fallback always under canvas — covers any WebGL clear/gap (no black hole flash). */
  .mercury-field__fallback {
    z-index: 0;
    opacity: 1;
    background:
      radial-gradient(ellipse 55% 40% at 35% 45%, rgba(200, 204, 210, 0.22), transparent 60%),
      radial-gradient(ellipse 50% 38% at 68% 55%, rgba(232, 234, 237, 0.14), transparent 58%),
      radial-gradient(ellipse 40% 30% at 50% 60%, rgba(138, 144, 153, 0.18), transparent 65%),
      linear-gradient(180deg, #050505, #0a0a0a);
  }

  .mercury-field__canvas {
    z-index: 1;
    display: block;
  }

  .mercury-field__veil {
    z-index: 2;
    background:
      linear-gradient(180deg, rgba(5, 5, 5, 0.72) 0%, rgba(5, 5, 5, 0.18) 45%, rgba(5, 5, 5, 0.48) 100%),
      radial-gradient(ellipse 80% 65% at 50% 45%, transparent 15%, rgba(5, 5, 5, 0.42) 100%);
  }

  .mercury-field.is-static .mercury-field__canvas {
    visibility: hidden;
  }

  .mercury-field--subtle .mercury-field__veil {
    background:
      linear-gradient(180deg, rgba(5, 5, 5, 0.88) 0%, rgba(5, 5, 5, 0.55) 55%, rgba(5, 5, 5, 0.92) 100%),
      radial-gradient(ellipse 70% 50% at 50% 0%, transparent 10%, rgba(5, 5, 5, 0.65) 100%);
  }

  .mercury-field--subtle .mercury-field__canvas {
    opacity: 0.55;
  }
</style>
