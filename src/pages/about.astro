---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title={`About — ${site.name}`} description={`About ${site.fullName}: mission, community, and executive team.`}>
  <main>
    <section class="section-shell page-intro">
      <div class="page-intro__sheen" aria-hidden="true"></div>
      <h1>About</h1>
      <p>{site.mission}</p>
    </section>

    <section id="team" class="section-shell" aria-labelledby="team-heading">
      <h2 id="team-heading">Team</h2>
      <p>Executive team coming soon.</p>
    </section>
  </main>
</BaseLayout>

<style>
  .page-intro {
    position: relative;
  }

  .page-intro__sheen {
    position: absolute;
    inset: -10% -5% auto;
    height: 12rem;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 60% 80% at 20% 40%, rgba(232, 234, 237, 0.12), transparent 70%),
      radial-gradient(ellipse 50% 70% at 75% 30%, rgba(200, 204, 210, 0.08), transparent 65%);
    filter: blur(18px);
    opacity: 0.85;
  }

  .page-intro :global(h1),
  .page-intro :global(p) {
    position: relative;
    z-index: 1;
  }
</style>
