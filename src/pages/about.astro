---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const pillars = [
  {
    title: "Interdisciplinary networks",
    body: "Connect students across medicine, science, engineering, and beyond — building relationships that clinical and technical problems actually need.",
  },
  {
    title: "Industry & startups",
    body: "Meet founders, sponsors, and practitioners through workshops, Meet the Start-Ups nights, and pathways into internships and early careers.",
  },
  {
    title: "Build together",
    body: "Hackathons, hands-on workshops, and member events where ideas move from conversation into prototypes — with community along the way.",
  },
] as const;
---

<BaseLayout
  title={`About — ${site.name}`}
  description="Learn about SUSMI — the University of Sydney society connecting medicine, biology, and technology through events, networks, and innovation."
>
  <main>
    <section class="section-shell page-intro">
      <div class="page-intro__sheen" aria-hidden="true"></div>
      <div class="glass-panel intro-card">
        <p class="eyebrow">About</p>
        <h1 class="mercury-text">Medicine, meeting technology</h1>
        <p class="lede">{site.about}</p>
      </div>
    </section>

    <section class="section-shell about-bridge" aria-labelledby="bridge-heading">
      <div class="glass-panel bridge-card">
        <h2 id="bridge-heading">Where medicine meets technology</h2>
        <p>
          Progress in healthcare now depends on people who can speak both languages: the realities of
          clinical care and biology, and the systems of engineering and computation that extend them.
          SUSMI exists in that overlap — not as a tech club bolted onto medicine, or a medical club
          curious about gadgets, but as a serious space for students who want to innovate at the
          interface.
        </p>
        <p>
          Through networking and events such as hackathons and workshops, members build relationships
          with peers and key figures in the medical industry, and develop the professional judgement
          to turn ambition into contribution.
        </p>
      </div>
    </section>

    <section class="section-shell about-pillars" aria-labelledby="pillars-heading">
      <h2 id="pillars-heading">What membership opens</h2>
      <ul class="pillar-list">
        {
          pillars.map((pillar) => (
            <li class="glass-panel pillar">
              <h3>{pillar.title}</h3>
              <p>{pillar.body}</p>
            </li>
          ))
        }
      </ul>
      <ul class="about-bullets glass-panel">
        <li>Connect with passionate, like-minded students across the University of Sydney</li>
        <li>Meet founders of medical startups — including teams looking for interns</li>
        <li>Join our annual hackathon and sponsor-hosted workshops</li>
        <li>Explore career options at Meet the Start-Ups and industry nights</li>
        <li>Member socials and food events that keep the community human</li>
      </ul>
    </section>

    <section id="team" class="section-shell about-team" aria-labelledby="team-heading">
      <div class="glass-panel team-card">
        <h2 id="team-heading">Team</h2>
        <p>
          Meet the executives shaping talks, workshops, and community at the med–bio–tech
          intersection.
        </p>
        <a class="btn btn-secondary" href="/team">Meet the execs</a>
      </div>
    </section>

    <section class="section-shell about-join" aria-labelledby="join-heading">
      <div class="glass-panel join-card">
        <h2 id="join-heading">Join SUSMI</h2>
        <p>
          Membership runs through the University of Sydney Union. Follow us on Instagram for what’s
          on, then join via USU to get involved.
        </p>
        <div class="about-join__actions">
          <a class="btn btn-primary" href={site.social.usu} rel="noopener noreferrer" target="_blank">
            Join via USU
          </a>
          <a
            class="btn btn-secondary"
            href={site.social.instagram}
            rel="noopener noreferrer"
            target="_blank"
          >
            Instagram
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-intro {
    position: relative;
    padding-bottom: 1.5rem;
  }

  .page-intro__sheen {
    position: absolute;
    inset: -12% -8% auto;
    height: 16rem;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 55% 80% at 18% 40%, rgba(232, 234, 237, 0.16), transparent 70%),
      radial-gradient(ellipse 45% 70% at 78% 30%, rgba(200, 204, 210, 0.1), transparent 65%);
    filter: blur(22px);
    opacity: 0.9;
  }

  .intro-card,
  .bridge-card,
  .team-card,
  .join-card {
    position: relative;
    z-index: 1;
    border-radius: 0.85rem;
    padding: clamp(1.4rem, 3.5vw, 2.15rem);
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mercury-dim);
  }

  .intro-card h1 {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.4rem, 7vw, 4.25rem);
    line-height: 0.95;
  }

  .lede {
    margin: 1.15rem 0 0;
    max-width: 40rem;
    font-size: clamp(1rem, 1.7vw, 1.12rem);
    line-height: 1.7;
    color: var(--text-muted);
  }

  .bridge-card h2,
  .about-pillars h2,
  .team-card h2,
  .join-card h2 {
    margin: 0;
    font-size: clamp(1.65rem, 3.4vw, 2.35rem);
  }

  .bridge-card p,
  .team-card p,
  .join-card p {
    max-width: 42rem;
    margin: 0.9rem 0 0;
    line-height: 1.7;
  }

  .pillar-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  @media (min-width: 800px) {
    .pillar-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pillar {
    border-radius: 0.7rem;
    padding: 1.2rem 1.25rem;
  }

  .pillar h3 {
    margin: 0;
    font-size: 1.08rem;
  }

  .pillar p {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
  }

  .about-bullets {
    list-style: none;
    margin: 1.15rem 0 0;
    padding: 1.2rem 1.3rem;
    border-radius: 0.7rem;
    display: grid;
    gap: 0.7rem;
  }

  .about-bullets li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .about-bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: linear-gradient(180deg, #e8eaed, #8a9099);
    box-shadow: 0 0 10px rgba(232, 234, 237, 0.35);
  }

  .team-card .btn,
  .about-join__actions {
    margin-top: 1.25rem;
  }

  .about-join__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
