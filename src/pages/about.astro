---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title={`About — ${site.name}`} description={`About ${site.fullName}: mission, community, and executive team.`}>
  <main>
    <section class="section-shell">
      <h1>About</h1>
      <p>{site.mission}</p>
    </section>
  </main>
</BaseLayout>
