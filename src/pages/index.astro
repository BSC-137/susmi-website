---
import BaseLayout from "../layouts/BaseLayout.astro";
import MercuryField from "../components/MercuryField.astro";
import { site } from "../data/site";
---

<BaseLayout>
  <main>
    <section class="hero-shell" aria-label="Hero">
      <MercuryField intensity="hero" />
      <div class="section-shell hero-shell__inner">
        <h1 class="hero-shell__brand mercury-text">{site.name}</h1>
        <p class="hero-shell__support">{site.fullName}</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero-shell {
    position: relative;
    min-height: calc(100dvh - 4rem);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-shell__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .hero-shell__brand {
    margin: 0;
    font-size: clamp(4.5rem, 16vw, 9rem);
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .hero-shell__support {
    margin: 1rem 0 0;
    max-width: 28rem;
    font-size: 1.0625rem;
    color: var(--mercury-bright);
    text-shadow: 0 1px 18px rgba(5, 5, 5, 0.65);
  }
</style>
