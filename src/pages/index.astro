---
import BaseLayout from "../layouts/BaseLayout.astro";
import MercuryField from "../components/MercuryField.astro";
import { site } from "../data/site";
import events from "../data/events.json";

const principles = [
  {
    title: "Interdisciplinary curiosity",
    body: "Medicine, biology, and engineering in the same room — asking better questions together.",
  },
  {
    title: "Build & prototype",
    body: "Workshops and hacks that move ideas from whiteboard to something you can hold or run.",
  },
  {
    title: "Community & discourse",
    body: "Talks, critiques, and quiet conversations that sharpen how we think about health tech.",
  },
] as const;

const upcoming = [...events]
  .sort((a, b) => a.date.localeCompare(b.date))
  .slice(0, 3);

function formatEventDate(iso: string) {
  const date = new Date(`${iso}T12:00:00`);
  return new Intl.DateTimeFormat("en-AU", {
    day: "numeric",
    month: "short",
  }).format(date);
}
---

<BaseLayout>
  <main>
    <section class="hero" aria-label="Hero">
      <MercuryField intensity="hero" />
      <div class="section-shell hero__inner">
        <p class="hero__eyebrow reveal" style="--d: 0ms">{site.semester}</p>
        <h1 class="hero__brand mercury-text reveal" style="--d: 80ms">{site.name}</h1>
        <p class="hero__headline reveal" style="--d: 160ms">Medicine. Biology. Technology.</p>
        <p class="hero__lede reveal" style="--d: 240ms">
          A University of Sydney society bridging clinical and biological thinking with engineering
          and computation — for students who want to build what’s next in health.
        </p>
        <div class="hero__ctas reveal" style="--d: 320ms">
          <a class="btn btn-primary" href="/events">See events</a>
          <a class="btn btn-secondary" href="/team">Meet the execs</a>
        </div>
      </div>
    </section>

    <section class="section-shell mission" aria-labelledby="mission-heading">
      <h2 id="mission-heading">Mission</h2>
      <p class="mission__lede">
        SUSMI exists where medicine meets the machines that will shape it. We gather students who
        think in pathways and in pipelines — who care as much about the patient as the prototype.
      </p>
      <ul class="mission__principles">
        {
          principles.map((item) => (
            <li class="glass-panel mission__principle">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section-shell semester" aria-labelledby="semester-heading">
      <div class="semester__head">
        <h2 id="semester-heading">This semester</h2>
        <p>{site.semester} — a few moments on the horizon.</p>
      </div>
      <ul class="event-rows">
        {
          upcoming.map((event) => (
            <li>
              <a class="event-row" href="/events">
                <time datetime={event.date}>{formatEventDate(event.date)}</time>
                <span class="event-row__title">{event.title}</span>
                <span class="event-row__type">{event.type}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="semester__more">
        <a class="text-link" href="/events">Full calendar</a>
      </p>
    </section>

    <section class="section-shell closing" aria-labelledby="closing-heading">
      <h2 id="closing-heading" class="closing__title">Join the room</h2>
      <p class="closing__copy">
        Come for a talk, stay for the workshops, hackathons, and the people who make health tech
        feel less solitary.
      </p>
      <a class="btn btn-primary" href={site.social.usu} rel="noopener noreferrer" target="_blank">
        Join via USU
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100dvh - 4rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: min(100% - 2.5rem, var(--section-max));
    margin-inline: auto;
    padding-block: clamp(3.5rem, 12vh, 6.5rem) clamp(3rem, 8vh, 5rem);
  }

  .hero__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mercury-dim);
  }

  .hero__brand {
    margin: 0;
    font-size: clamp(4.25rem, 18vw, 9.5rem);
    letter-spacing: -0.06em;
    line-height: 0.88;
  }

  .hero__headline {
    margin: 1.25rem 0 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.2vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--mercury-bright);
  }

  .hero__lede {
    margin: 1rem 0 0;
    max-width: 36rem;
    font-size: clamp(0.98rem, 1.6vw, 1.1rem);
    line-height: 1.65;
    color: var(--text-muted);
    text-shadow: 0 1px 20px rgba(5, 5, 5, 0.55);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  @media (max-width: 520px) {
    .hero__ctas {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__ctas :global(.btn) {
      width: 100%;
    }
  }

  .reveal {
    opacity: 0;
    transform: translateY(0.85rem);
    animation: rise-in 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes rise-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mission h2,
  .semester h2,
  .closing__title {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .mission__lede {
    margin: 1rem 0 0;
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .mission__principles {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .mission__principle {
    padding: 1.15rem 1.25rem;
    border-radius: 0.5rem;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .mission__principle:hover {
    border-color: rgba(232, 234, 237, 0.28);
    background: rgba(200, 204, 210, 0.1);
    box-shadow:
      inset 0 1px 0 rgba(232, 234, 237, 0.2),
      0 0 0 1px rgba(200, 204, 210, 0.04);
  }

  .mission__principle h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--mercury-bright);
  }

  .mission__principle p {
    margin: 0.4rem 0 0;
    max-width: 42rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .semester__head p {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
  }

  .event-rows {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--glass-border);
  }

  .event-row {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 1.15rem 0.35rem;
    border-bottom: 1px solid rgba(232, 234, 237, 0.1);
    color: inherit;
    position: relative;
    transition: background-color 160ms ease;
  }

  .event-row::after {
    content: "";
    position: absolute;
    left: 0.35rem;
    right: 0.35rem;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--mercury-dim) 12%,
      var(--mercury-bright) 50%,
      var(--mercury-dim) 88%,
      transparent
    );
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .event-row:hover {
    background: rgba(200, 204, 210, 0.05);
    color: inherit;
  }

  .event-row:hover::after {
    opacity: 0.95;
  }

  .event-row time {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--mercury-dim);
  }

  .event-row__title {
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--mercury-bright);
  }

  .event-row__type {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mercury-dim);
  }

  @media (max-width: 640px) {
    .event-row {
      grid-template-columns: 3.75rem 1fr;
      gap: 0.35rem 0.85rem;
    }

    .event-row__type {
      grid-column: 2;
    }
  }

  .semester__more {
    margin: 1.5rem 0 0;
  }

  .text-link {
    color: var(--mercury);
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition:
      color 160ms ease,
      border-color 160ms ease;
  }

  .text-link:hover {
    color: var(--mercury-bright);
    border-bottom-color: rgba(232, 234, 237, 0.35);
  }

  .closing {
    text-align: left;
  }

  .closing__copy {
    margin: 0.85rem 0 1.5rem;
    max-width: 32rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .mission__principle,
    .event-row,
    .event-row::after,
    .text-link {
      transition: none;
    }
  }
</style>
