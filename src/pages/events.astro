---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import rawEvents from "../data/events.json";
import {
  buildMonthGrid,
  formatLongDate,
  formatMonthLabel,
  formatShortDate,
  getSemesterMonths,
  todayIsoSydney,
  type SusmiEvent,
} from "../lib/events";

const events = [...(rawEvents as SusmiEvent[])].sort((a, b) =>
  a.date === b.date ? a.time.localeCompare(b.time) : a.date.localeCompare(b.date),
);

const months = getSemesterMonths(events);
const eventsByDate = new Map<string, SusmiEvent[]>();
for (const event of events) {
  const list = eventsByDate.get(event.date) ?? [];
  list.push(event);
  eventsByDate.set(event.date, list);
}

const today = todayIsoSydney();
const firstEventDate = events[0]?.date ?? months[0] + "-01";
const initialMonth = firstEventDate.slice(0, 7);
const initialSelected = eventsByDate.has(today) ? today : firstEventDate;

const monthModels = months.map((key) => {
  const [year, month] = key.split("-").map(Number);
  return {
    key,
    year,
    month,
    label: formatMonthLabel(year, month),
    cells: buildMonthGrid(year, month),
  };
});

const filters = [
  { id: "all", label: "All" },
  { id: "talk", label: "Talk" },
  { id: "workshop", label: "Workshop" },
  { id: "social", label: "Social" },
  { id: "hack", label: "Hack" },
] as const;

const weekdays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
---

<BaseLayout
  title="Events — SUSMI"
  description={`${site.semester} talks, workshops, and builds from ${site.fullName}.`}
>
  <main>
    <section class="section-shell page-intro">
      <div class="page-intro__sheen" aria-hidden="true"></div>
      <h1>Events</h1>
      <p>
        Talks, workshops, and builds at the intersection of medicine, biology, and technology —
        {site.semester}.
      </p>
    </section>

    <section
      class="section-shell events-app"
      data-events-root
      data-initial-month={initialMonth}
      data-initial-selected={initialSelected}
      aria-label="Semester events"
    >
      <div class="view-toggle glass-panel" role="tablist" aria-label="Events view" data-view-tabs>
        <button
          type="button"
          role="tab"
          id="tab-calendar"
          data-view-tab="calendar"
          aria-controls="panel-calendar"
          aria-selected="true"
          tabindex="0"
        >
          Calendar
        </button>
        <button
          type="button"
          role="tab"
          id="tab-list"
          data-view-tab="list"
          aria-controls="panel-list"
          aria-selected="false"
          tabindex="-1"
        >
          List
        </button>
      </div>

      <div
        class="events-panel"
        role="tabpanel"
        id="panel-calendar"
        aria-labelledby="tab-calendar"
        data-panel="calendar"
      >
        <div class="calendar-layout">
          <div class="calendar-board glass-panel">
            <div class="calendar-toolbar">
              <button type="button" class="month-nav" data-month-prev aria-label="Previous month">
                ‹
              </button>
              <h2 class="calendar-month" data-month-label>{monthModels[0]?.label}</h2>
              <button type="button" class="month-nav" data-month-next aria-label="Next month">
                ›
              </button>
            </div>

            <div class="weekday-row" aria-hidden="true">
              {weekdays.map((day) => <span>{day}</span>)}
            </div>

            {
              monthModels.map((model) => (
                <div
                  class="month-grid"
                  data-month-panel={model.key}
                  data-month-label={model.label}
                  hidden={model.key !== initialMonth}
                >
                  {model.cells.map((cell) => {
                    if (!cell.iso || cell.day === null) {
                      return <div class="day-cell day-cell--empty" aria-hidden="true" />;
                    }
                    const dayEvents = eventsByDate.get(cell.iso) ?? [];
                    const hasEvents = dayEvents.length > 0;
                    const isToday = cell.iso === today;
                    return (
                      <button
                        type="button"
                        class:list={[
                          "day-cell",
                          hasEvents && "day-cell--event",
                          isToday && "day-cell--today",
                        ]}
                        data-day={cell.iso}
                        data-day-label={formatLongDate(cell.iso)}
                        data-has-events={hasEvents ? "true" : "false"}
                        aria-label={`${formatLongDate(cell.iso)}${hasEvents ? `, ${dayEvents.length} event${dayEvents.length > 1 ? "s" : ""}` : ""}`}
                        aria-pressed="false"
                      >
                        <span class="day-cell__num">{cell.day}</span>
                        {hasEvents && <span class="day-cell__dot" aria-hidden="true" />}
                      </button>
                    );
                  })}
                </div>
              ))
            }
          </div>

          <aside
            class="events-detail glass-panel"
            data-day-detail
            data-heading-prefix="Events on"
            data-empty-title="Nothing scheduled"
            data-empty-copy="No SUSMI events on this day."
          >
            <h2 data-detail-title>Select a day</h2>
            <div data-detail-body>
              <p class="events-detail__empty">Choose a highlighted day to see what’s on.</p>
            </div>
          </aside>
        </div>

        <!-- Hidden templates for day detail hydration -->
        <div class="sr-only" aria-hidden="true">
          {
            events.map((event) => (
              <div data-event-date={event.date} data-event-id={event.id}>
                <p class="events-detail__meta">
                  <time datetime={`${event.date}T${event.time}`}>{event.time}</time>
                  <span>{event.type}</span>
                </p>
                <h3>{event.title}</h3>
                <p class="events-detail__location">{event.location}</p>
                <p class="events-detail__desc">{event.description}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="events-panel"
        role="tabpanel"
        id="panel-list"
        aria-labelledby="tab-list"
        data-panel="list"
        hidden
      >
        <div class="filter-row" role="group" aria-label="Filter by type">
          {
            filters.map((filter) => (
              <button
                type="button"
                class:list={["filter-chip", filter.id === "all" && "is-active"]}
                data-filter={filter.id}
                aria-pressed={filter.id === "all" ? "true" : "false"}
              >
                {filter.label}
              </button>
            ))
          }
        </div>

        <ol class="agenda">
          {
            events.map((event) => (
              <li data-list-item data-event-type={event.type}>
                <details class="agenda-item glass-panel">
                  <summary>
                    <span class="agenda-item__date">
                      <time datetime={event.date}>{formatShortDate(event.date)}</time>
                      <span>{event.time}</span>
                    </span>
                    <span class="agenda-item__main">
                      <span class="agenda-item__title">{event.title}</span>
                      <span class="agenda-item__loc">{event.location}</span>
                    </span>
                    <span class="agenda-item__type">{event.type}</span>
                  </summary>
                  <p>{event.description}</p>
                </details>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { initEventsPage } from "../scripts/events-ui";

  const boot = () => {
    const root = document.querySelector<HTMLElement>("[data-events-root]");
    if (root && !root.dataset.ready) {
      root.dataset.ready = "1";
      initEventsPage(root);
    }
  };

  boot();
  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>("[data-events-root]");
    if (root) delete root.dataset.ready;
    boot();
  });
</script>

<style>
  .page-intro {
    position: relative;
    padding-bottom: 2rem;
  }

  .page-intro__sheen {
    position: absolute;
    inset: -10% -5% auto;
    height: 12rem;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 60% 80% at 20% 40%, rgba(232, 234, 237, 0.12), transparent 70%),
      radial-gradient(ellipse 50% 70% at 75% 30%, rgba(200, 204, 210, 0.08), transparent 65%);
    filter: blur(18px);
    opacity: 0.85;
  }

  .page-intro :global(h1),
  .page-intro :global(p) {
    position: relative;
    z-index: 1;
  }

  .page-intro :global(p) {
    max-width: 38rem;
  }

  .events-app {
    padding-top: 0;
  }

  .view-toggle {
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .view-toggle button {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    min-height: 2.4rem;
    padding: 0.45rem 1.1rem;
    border-radius: 0.375rem;
    cursor: pointer;
  }

  .view-toggle button[aria-selected="true"] {
    color: var(--bg);
    background: linear-gradient(180deg, #e8eaed 0%, #c8ccd2 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .calendar-layout {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 960px) {
    .calendar-layout {
      grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.85fr);
      align-items: start;
    }
  }

  .calendar-board {
    border-radius: 0.65rem;
    padding: 1rem;
  }

  .calendar-toolbar {
    display: grid;
    grid-template-columns: 2.5rem 1fr 2.5rem;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .calendar-month {
    margin: 0;
    text-align: center;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .month-nav {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.375rem;
    border: 1px solid var(--glass-border);
    background: rgba(200, 204, 210, 0.05);
    color: var(--mercury-bright);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .month-nav:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .month-nav:not(:disabled):hover {
    background: rgba(200, 204, 210, 0.12);
  }

  .weekday-row {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.35rem;
    margin-bottom: 0.35rem;
  }

  .weekday-row span {
    text-align: center;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mercury-dim);
  }

  .month-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.35rem;
  }

  .day-cell {
    position: relative;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(232, 234, 237, 0.08);
    border-radius: 0.4rem;
    background: #050505;
    color: var(--text-muted);
    font: inherit;
    cursor: pointer;
  }

  .day-cell--empty {
    border-color: transparent;
    background: transparent;
    pointer-events: none;
  }

  .day-cell__num {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .day-cell__dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: linear-gradient(180deg, #e8eaed, #8a9099);
    box-shadow: 0 0 8px rgba(232, 234, 237, 0.35);
  }

  .day-cell--event {
    background: rgba(200, 204, 210, 0.06);
    border-color: rgba(232, 234, 237, 0.16);
    color: var(--mercury-bright);
  }

  .day-cell--today {
    box-shadow: inset 0 0 0 1px rgba(232, 234, 237, 0.28);
  }

  .day-cell.is-selected,
  .day-cell[aria-pressed="true"] {
    background: rgba(200, 204, 210, 0.14);
    border-color: rgba(232, 234, 237, 0.45);
    color: var(--mercury-bright);
    box-shadow:
      inset 0 1px 0 rgba(232, 234, 237, 0.22),
      0 0 0 1px rgba(200, 204, 210, 0.12);
  }

  .day-cell:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .events-detail {
    border-radius: 0.65rem;
    padding: 1.25rem;
    min-height: 14rem;
  }

  .events-detail h2 {
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }

  .events-detail__item + .events-detail__item {
    margin-top: 1.15rem;
    padding-top: 1.15rem;
    border-top: 1px solid rgba(232, 234, 237, 0.1);
  }

  .events-detail__meta {
    display: flex;
    gap: 0.75rem;
    margin: 0 0 0.4rem;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mercury-dim);
  }

  .events-detail h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .events-detail__location,
  .events-detail__desc,
  .events-detail__empty {
    margin: 0.45rem 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
  }

  .filter-chip {
    appearance: none;
    border: 1px solid var(--glass-border);
    background: rgba(200, 204, 210, 0.04);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 0.4rem 0.75rem;
    border-radius: 0.35rem;
    cursor: pointer;
  }

  .filter-chip.is-active,
  .filter-chip[aria-pressed="true"] {
    color: var(--bg);
    background: linear-gradient(180deg, #e8eaed, #c8ccd2);
    border-color: transparent;
  }

  .agenda {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  .agenda-item {
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .agenda-item summary {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    gap: 0.85rem 1rem;
    align-items: start;
    padding: 1rem 1.1rem;
    cursor: pointer;
    list-style: none;
  }

  .agenda-item summary::-webkit-details-marker {
    display: none;
  }

  .agenda-item__date {
    display: grid;
    gap: 0.2rem;
    font-size: 0.875rem;
    color: var(--mercury-dim);
  }

  .agenda-item__date time {
    color: var(--mercury-bright);
    font-weight: 500;
  }

  .agenda-item__main {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .agenda-item__title {
    color: var(--mercury-bright);
    font-weight: 500;
  }

  .agenda-item__loc {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .agenda-item__type {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--mercury-dim);
    padding-top: 0.15rem;
  }

  .agenda-item p {
    margin: 0;
    padding: 0 1.1rem 1.1rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 42rem;
  }

  @media (max-width: 720px) {
    .agenda-item summary {
      grid-template-columns: 4.25rem 1fr;
    }

    .agenda-item__type {
      grid-column: 2;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .view-toggle button,
    .day-cell,
    .filter-chip,
    .month-nav {
      transition: none;
    }
  }
</style>
